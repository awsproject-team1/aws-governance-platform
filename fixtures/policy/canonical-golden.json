        "raw_block": "Access Control Policy\n\nThis policy defines the minimum access requirements."
      },
      {
        "section": "access-control-policy/account-management",
        "locator": "pdf:page=1/block=3",
        "content_hash": "sha256:f0d099049c52a38edd1bdff1eb89795943195182b7f9031d4b9d19a6d2cda218",
        "raw_block": "Account Management\n\nShared accounts are prohibited.\nExceptions require a recorded approval."
      },
      {
        "section": "access-control-policy/periodic-review",
        "locator": "pdf:page=2/block=1",
        "content_hash": "sha256:240d148aa01ad0c17c77fa19bdd6c5805919ed75ed7554b29a6a81197862adaf",
        "raw_block": "Periodic Review\n\nAccess rights are reviewed every quarter."
      }
    ]
